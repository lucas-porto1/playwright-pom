{
  "name": "playwright-pom-reference",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:chromium"
  },
  "keywords": [],
  "author": "Lucas Porto",
  "license": "ISC",
  "description": "Reference architecture for end-to-end QA automation with Playwright and Page Objects.",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.9.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
